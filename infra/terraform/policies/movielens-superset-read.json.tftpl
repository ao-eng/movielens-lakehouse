{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AthenaQueriesInProjectWorkgroup",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup"
      ],
      "Resource": "arn:aws:athena:${region}:${account_id}:workgroup/${workgroup}"
    },
    {
      "Sid": "AthenaCatalogMetadata",
      "Effect": "Allow",
      "Action": [
        "athena:GetDataCatalog",
        "athena:ListDatabases",
        "athena:GetDatabase",
        "athena:ListTableMetadata",
        "athena:GetTableMetadata"
      ],
      "Resource": "arn:aws:athena:${region}:${account_id}:datacatalog/AwsDataCatalog"
    },
    {
      "Sid": "AthenaListCatalogs",
      "Effect": "Allow",
      "Action": "athena:ListDataCatalogs",
      "Resource": "*"
    },
    {
      "Sid": "GlueReadOnly",
      "Effect": "Allow",
      "Action": [
        "glue:GetCatalog",
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:${region}:${account_id}:catalog",
        "arn:aws:glue:${region}:${account_id}:database/movielens",
        "arn:aws:glue:${region}:${account_id}:table/movielens/*"
      ]
    },
    {
      "Sid": "S3ListWarehouseAndResults",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${bucket}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["movielens/warehouse/*", "movielens/athena-results/*"]
        }
      }
    },
    {
      "Sid": "S3BucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::${bucket}"
    },
    {
      "Sid": "S3ReadWarehouse",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${bucket}/movielens/warehouse/*"
    },
    {
      "Sid": "S3WriteAthenaResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::${bucket}/movielens/athena-results/*"
    }
  ]
}
