{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlueCatalogMovielens",
      "Effect": "Allow",
      "Action": [
        "glue:GetCatalog",
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartitions",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable"
      ],
      "Resource": [
        "arn:aws:glue:${region}:${account_id}:catalog",
        "arn:aws:glue:${region}:${account_id}:database/movielens",
        "arn:aws:glue:${region}:${account_id}:table/movielens/*"
      ]
    },
    {
      "Sid": "S3ListMovielensPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${bucket}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["movielens", "movielens/*"]
        }
      }
    },
    {
      "Sid": "S3BucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::${bucket}"
    },
    {
      "Sid": "S3ReadWriteMovielensObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::${bucket}/movielens/*"
    }
  ]
}
